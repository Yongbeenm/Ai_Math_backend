# Copy this file to `.env` and adjust as needed.
# `.env` itself should NOT be committed to git (see .gitignore).

APP_NAME="Khmer Math Lab API"
APP_VERSION=0.1.0
DEBUG=true

# JSON array of allowed origins. "*" is fine for local development against
# a Flutter app running on an emulator/simulator. Tighten this once you
# have a real deployment domain.
CORS_ORIGINS=["*"]

# aiosqlite for local dev on the M3 Pro. Swap for Postgres later, e.g.:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/khmer_math_lab
DATABASE_URL=sqlite+aiosqlite:///./khmer_math_lab.db

# Math Vision / OCR Configuration
# Choose provider: "stub" (default, no OCR), "tesseract" (free, offline),
# "mathpix" (best for math), or "google" (good for Khmer)
VISION_PROVIDER=stub

# Tesseract (if VISION_PROVIDER=tesseract)
# No additional config needed - uses local Tesseract installation

# Mathpix (if VISION_PROVIDER=mathpix)
# Sign up at https://mathpix.com/ to get credentials
# MATHPIX_APP_ID=your_app_id
# MATHPIX_APP_KEY=your_app_key

# Google Cloud Vision (if VISION_PROVIDER=google)
# Download service account JSON from Google Cloud Console
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

